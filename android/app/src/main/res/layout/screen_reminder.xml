<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/reminder_habit"
            style="@style/Habitline.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reminder_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reminder_enabled" />

        <LinearLayout
            android:id="@+id/reminder_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reminder_time"
                style="@style/Habitline.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <TextView
                style="@style/Habitline.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reminder_schedule_hint" />

            <LinearLayout
                android:id="@+id/reminder_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/reminder_permission_message"
            style="@style/Habitline.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reminder_notifications_paused"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reminder_permission"
            style="@style/Habitline.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reminder_notification_access"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reminder_error"
            style="@style/Habitline.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/reminder_days_required"
            android:textColor="@color/app_error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_reminder"
            style="@style/Habitline.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
