<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_500"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textColor="@color/ink_50"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_subtitle"
        android:textColor="@color/ink_50_60"
        android:textSize="13sp"
        android:paddingBottom="16dp" />

    <ListView
        android:id="@+id/habitListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp" />

    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/empty_habits_message"
        android:textColor="@color/ink_50_60"
        android:gravity="center"
        android:padding="24dp" />

    <Button
        android:id="@+id/openAppButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/open_app_to_add_habit"
        android:backgroundTint="@color/accent_amber" />

</LinearLayout>
