<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Habitline" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryDark">@color/app_background</item>
        <item name="colorSecondary">@color/app_primary</item>
        <item name="colorOnSecondary">@color/app_on_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="shapeAppearanceSmallComponent">@style/Habitline.Shape.Small</item>
    </style>
    <style name="Habitline.Shape.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Habitline.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Habitline.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Habitline.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Habitline.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Habitline.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Habitline.Title" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Habitline.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Habitline.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Habitline.Caption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/app_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
